PATH_TO_SERVICE_VOLUMES=/path/to/services
TZ=Etc/UTC
PATH_TO_NEXTCLOUD_DATA=/path/to/nextcloud-data
PATH_TO_JELLYFIN_MEDIA=/path/to/media

# Static IPs on the macvlan network. Pick free addresses inside the network's
# ip-range (outside your router's DHCP pool) and keep them unique across stacks
# (immich-app/.env also has one).
PIHOLE_IP=192.0.2.10
NXTCLD_IP=192.0.2.11
HASS_IP=192.0.2.12
JELLYFIN_IP=192.0.2.13
