{
  "uid": "host",
  "title": "Host",
  "tags": [
    "node-exporter",
    "host"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "gauge",
      "title": "CPU",
      "datasource": {
        "type": "prometheus",
        "uid": "disk-report-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 70
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "disk-report-prom"
          },
          "expr": "100 - avg(rate(node_cpu_seconds_total{instance=\"server\",mode=\"idle\"}[1m]))*100"
        }
      ]
    },
    {
      "id": 2,
      "type": "gauge",
      "title": "Memory",
      "datasource": {
        "type": "prometheus",
        "uid": "disk-report-prom"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 75
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "disk-report-prom"
          },
          "expr": "(1 - node_memory_MemAvailable_bytes{instance=\"server\"}/node_memory_MemTotal_bytes{instance=\"server\"})*100"
        }
      ]
    },
    {
      "id": 3,
      "type": "gauge",
      "title": "Root disk",
      "datasource": {
        "type": "prometheus",
        "uid": "disk-report-prom"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "disk-report-prom"
          },
          "expr": "(1 - node_filesystem_avail_bytes{instance=\"server\",mountpoint=\"/\"}/node_filesystem_size_bytes{instance=\"server\",mountpoint=\"/\"})*100"
        }
      ]
    },
    {
      "id": 4,
      "type": "gauge",
      "title": "Vault disk",
      "datasource": {
        "type": "prometheus",
        "uid": "disk-report-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "disk-report-prom"
          },
          "expr": "(1 - node_filesystem_avail_bytes{instance=\"server\",mountpoint=\"/mnt/vault\"}/node_filesystem_size_bytes{instance=\"server\",mountpoint=\"/mnt/vault\"})*100"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Max temperature",
      "datasource": {
        "type": "prometheus",
        "uid": "disk-report-prom"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 70
              },
              {
                "color": "red",
                "value": 85
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "disk-report-prom"
          },
          "expr": "max(node_hwmon_temp_celsius{instance=\"server\"})"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Uptime",
      "datasource": {
        "type": "prometheus",
        "uid": "disk-report-prom"
      },
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "disk-report-prom"
          },
          "expr": "time() - node_boot_time_seconds{instance=\"server\"}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "CPU usage by mode",
      "datasource": {
        "type": "prometheus",
        "uid": "disk-report-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "fillOpacity": 40,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "disk-report-prom"
          },
          "expr": "sum by (mode)(rate(node_cpu_seconds_total{instance=\"server\",mode!=\"idle\"}[1m])) / scalar(count(node_cpu_seconds_total{instance=\"server\",mode=\"idle\"}))*100",
          "legendFormat": "{{mode}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Load average",
      "datasource": {
        "type": "prometheus",
        "uid": "disk-report-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "disk-report-prom"
          },
          "expr": "node_load1{instance=\"server\"}",
          "legendFormat": "1m"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "disk-report-prom"
          },
          "expr": "node_load5{instance=\"server\"}",
          "legendFormat": "5m"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "disk-report-prom"
          },
          "expr": "node_load15{instance=\"server\"}",
          "legendFormat": "15m"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "disk-report-prom"
          },
          "expr": "count(node_cpu_seconds_total{instance=\"server\",mode=\"idle\"})",
          "legendFormat": "CPU cores"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Memory",
      "datasource": {
        "type": "prometheus",
        "uid": "disk-report-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "disk-report-prom"
          },
          "expr": "node_memory_MemTotal_bytes{instance=\"server\"} - node_memory_MemAvailable_bytes{instance=\"server\"}",
          "legendFormat": "Used"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "disk-report-prom"
          },
          "expr": "node_memory_Cached_bytes{instance=\"server\"} + node_memory_Buffers_bytes{instance=\"server\"}",
          "legendFormat": "Cache/buffers"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "disk-report-prom"
          },
          "expr": "node_memory_MemTotal_bytes{instance=\"server\"}",
          "legendFormat": "Total"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "disk-report-prom"
          },
          "expr": "node_memory_SwapTotal_bytes{instance=\"server\"} - node_memory_SwapFree_bytes{instance=\"server\"}",
          "legendFormat": "Swap used"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Disk space used",
      "datasource": {
        "type": "prometheus",
        "uid": "disk-report-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1
          },
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "disk-report-prom"
          },
          "expr": "(1 - node_filesystem_avail_bytes{instance=\"server\",fstype!~\"tmpfs|overlay|squashfs|vfat\"}/node_filesystem_size_bytes{instance=\"server\",fstype!~\"tmpfs|overlay|squashfs|vfat\"})*100",
          "legendFormat": "{{mountpoint}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Network traffic",
      "datasource": {
        "type": "prometheus",
        "uid": "disk-report-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "disk-report-prom"
          },
          "expr": "rate(node_network_receive_bytes_total{instance=\"server\",device!~\"lo|veth.*|br-.*|docker.*|macvlan.*\"}[1m])",
          "legendFormat": "{{device}} in"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "disk-report-prom"
          },
          "expr": "-rate(node_network_transmit_bytes_total{instance=\"server\",device!~\"lo|veth.*|br-.*|docker.*|macvlan.*\"}[1m])",
          "legendFormat": "{{device}} out"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Disk I/O",
      "datasource": {
        "type": "prometheus",
        "uid": "disk-report-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "disk-report-prom"
          },
          "expr": "rate(node_disk_read_bytes_total{instance=\"server\",device!~\"dm-.*|loop.*|zram.*\"}[1m])",
          "legendFormat": "{{device}} read"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "disk-report-prom"
          },
          "expr": "-rate(node_disk_written_bytes_total{instance=\"server\",device!~\"dm-.*|loop.*|zram.*\"}[1m])",
          "legendFormat": "{{device}} write"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Temperatures",
      "datasource": {
        "type": "prometheus",
        "uid": "disk-report-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "disk-report-prom"
          },
          "expr": "node_hwmon_temp_celsius{instance=\"server\"}",
          "legendFormat": "{{chip}} {{sensor}}"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Disk busy time",
      "datasource": {
        "type": "prometheus",
        "uid": "disk-report-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 29,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1
          },
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "disk-report-prom"
          },
          "expr": "rate(node_disk_io_time_seconds_total{instance=\"server\",device!~\"dm-.*|loop.*|zram.*\"}[1m])*100",
          "legendFormat": "{{device}}"
        }
      ]
    }
  ]
}